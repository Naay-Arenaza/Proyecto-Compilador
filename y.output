   0  $accept : programa $end

   1  programa : ID sentencias_declarativas BEGIN sentencias_ejecutables END
   2           | error sentencias_declarativas BEGIN sentencias_ejecutables END
   3           | ID sentencias_declarativas error sentencias_ejecutables END
   4           | ID sentencias_declarativas BEGIN sentencias_ejecutables error

   5  sentencias_declarativas : sentencias_declarativas sentencia_declarativa
   6                          |

   7  sentencia_declarativa : declaracion_variables
   8                        | declaracion_variables_comptime
   9                        | declaracion_funcion
  10                        | declaracion_clase
  11                        | declaracion_objeto

  12  declaracion_variables : tipo lista_variables ';'
  13                        | tipo lista_variables

  14  declaracion_variables_comptime : COMPTIME tipo lista_variables ';'
  15                                 | COMPTIME tipo lista_variables error
  16                                 | COMPTIME lista_variables ';'

  17  tipo : USHORTINT
  18       | DOUBLEF

  19  lista_variables : lista_variables ',' ID
  20                  | lista_variables ID
  21                  | ID

  22  declaracion_funcion : tipo FUNCTION ID '(' parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  23                      | tipo FUNCTION error '(' parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  24                      | tipo FUNCTION ID '(' parametros_formales ')' sentencias_declarativas error sentencias_ejecutables END ';'
  25                      | tipo FUNCTION ID '(' parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables error ';'
  26                      | tipo FUNCTION ID '(' parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  27                      | tipo FUNCTION ID '(' error ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'

  28  parametros_formales : parametros_formales ',' parametro_formal
  29                      | parametro_formal

  30  parametro_formal : tipo ID
  31                   | ID
  32                   | tipo

  33  declaracion_clase : CLASS ID BEGIN cuerpo_clase END ';'
  34                    | CLASS ID error cuerpo_clase END ';'
  35                    | CLASS ID BEGIN cuerpo_clase error ';'
  36                    | CLASS ID BEGIN cuerpo_clase END

  37  cuerpo_clase : elementos_clase sentencia_extends
  38               | elementos_clase
  39               | sentencia_extends
  40               |

  41  elementos_clase : elementos_clase elemento_clase
  42                  | elemento_clase

  43  elemento_clase : declaracion_variables
  44                 | declaracion_metodo

  45  sentencia_extends : EXTENDS lista_ids ';'
  46                    | EXTENDS error ';'
  47                    | EXTENDS lista_ids
  48                    | EXTENDS ';'

  49  lista_ids : lista_ids ',' ID
  50            | ID

  51  declaracion_metodo : tipo ID '(' parametros_formales ')' BEGIN sentencias_ejecutables END ';'
  52                     | tipo ID '(' parametros_formales ')' error sentencias_ejecutables END ';'
  53                     | tipo ID '(' error ')' BEGIN sentencias_ejecutables END ';'
  54                     | tipo ID '(' parametros_formales ')' BEGIN sentencias_ejecutables error ';'
  55                     | tipo ID '(' parametros_formales ')' BEGIN sentencias_ejecutables END

  56  declaracion_objeto : ID lista_variables ';'
  57                     | ID lista_variables

  58  sentencias_ejecutables : sentencias_ejecutables sentencia_ejecutable
  59                         | sentencia_ejecutable

  60  sentencia_ejecutable : asignacion ';'
  61                       | seleccion ';'
  62                       | salida ';'
  63                       | retorno ';'
  64                       | iterativa ';'
  65                       | asignacion
  66                       | seleccion
  67                       | salida
  68                       | retorno
  69                       | iterativa

  70  asignacion : lado_izquierdo ASIGNACION expresion
  71             | lado_izquierdo '=' expresion

  72  lado_izquierdo : ID
  73                 | acceso_posicional

  74  acceso_posicional : ID '[' indice ']'

  75  indice : ID
  76         | CTE

  77  expresion : expresion '+' termino
  78            | expresion '-' termino
  79            | expresion '+' error
  80            | error '+' termino
  81            | expresion '-' error
  82            | error '-' termino
  83            | termino

  84  termino : termino '*' factor
  85          | termino '/' factor
  86          | termino '*' error
  87          | error '*' factor
  88          | error '/' factor
  89          | termino '/' error
  90          | factor

  91  factor : ID
  92         | CTE
  93         | acceso_posicional
  94         | ID '=' '(' expresion ')'
  95         | TODF '(' expresion ')'
  96         | invocacion

  97  invocacion : ID '(' parametros_reales ')' lista_constantes_opcional
  98             | ID '.' ID '(' parametros_reales ')' lista_constantes_opcional
  99             | ID '(' error ')' lista_constantes_opcional
 100             | ID '.' ID '(' error ')' lista_constantes_opcional

 101  lista_constantes_opcional : '[' lista_constantes ']'
 102                            | '[' error ']'
 103                            |

 104  lista_constantes : lista_constantes ',' CTE
 105                   | CTE

 106  parametros_reales : parametros_reales ',' parametro_real
 107                    | parametro_real

 108  parametro_real : expresion

 109  iterativa : REPEAT bloque_ejecutable WHILE '(' condicion ')'
 110            | REPEAT bloque_ejecutable error '(' condicion ')'
 111            | REPEAT bloque_ejecutable WHILE '(' condicion
 112            | REPEAT bloque_ejecutable WHILE condicion ')'
 113            | REPEAT bloque_ejecutable WHILE condicion
 114            | REPEAT WHILE '(' condicion ')'

 115  seleccion : IF '(' condicion ')' bloque_ejecutable ELSE bloque_ejecutable END_IF
 116            | IF '(' condicion ')' bloque_ejecutable END_IF
 117            | IF '(' condicion bloque_ejecutable END_IF
 118            | IF condicion ')' bloque_ejecutable END_IF
 119            | IF condicion bloque_ejecutable END_IF
 120            | IF '(' condicion ')' bloque_ejecutable error

 121  condicion : expresion comparador expresion

 122  comparador : IGUAL
 123             | DISTINTO
 124             | MAYORIGUAL
 125             | MENORIGUAL
 126             | '>'
 127             | '<'

 128  bloque_ejecutable : sentencia_ejecutable
 129                    | BEGIN sentencias_ejecutables END
 130                    | error sentencias_ejecutables END
 131                    | BEGIN sentencias_ejecutables error

 132  salida : POUT '(' CADENA ')'
 133         | POUT '(' expresion ')'
 134         | POUT '(' ')'

 135  retorno : RET '(' expresion ')'

